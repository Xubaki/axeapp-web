# ============================================================
# AxéApp Web — Variáveis de Ambiente
# Hostinger: Sites → appaxe.com.br → Variáveis de ambiente
# Depois: Implantações → Reimplantar
# ============================================================

# MESMA API do app (Manus). Obrigatório no painel Hostinger.
NEXT_PUBLIC_API_URL=https://axeapp-vdtapk2t.manus.space

# Segredo JWT só do cookie do painel web (não precisa ser o da API Manus).
# Gere com: openssl rand -base64 32
JWT_SECRET=seu-segredo-jwt-aqui

NODE_ENV=production
